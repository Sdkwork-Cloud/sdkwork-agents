page {
  background: #141414;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.subtitle {
  color: #9ca3af;
  font-size: 24rpx;
}

.link {
  color: #60a5fa;
  font-size: 24rpx;
}

.status {
  color: #d1d5db;
  font-size: 28rpx;
  padding: 48rpx 0;
  text-align: center;
}

.status.error {
  color: #f87171;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: #1f2937;
  border-radius: 16rpx;
  padding: 24rpx;
}

.name {
  display: block;
  color: #f9fafb;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.desc {
  display: block;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 1.5;
}
