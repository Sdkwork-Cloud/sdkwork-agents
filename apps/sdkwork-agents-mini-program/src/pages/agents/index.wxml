<view class="page">
  <view class="header">
    <text class="subtitle">原生列表 · App API</text>
    <navigator url="/pages/agents-h5/index" class="link">H5 完整版</navigator>
  </view>

  <view wx:if="{{loading}}" class="status">加载中...</view>
  <view wx:elif="{{error}}" class="status error">{{error}}</view>
  <view wx:elif="{{agents.length === 0}}" class="status">暂无智能体</view>

  <view wx:else class="list">
    <block wx:for="{{agents}}" wx:key="id">
      <view class="card">
        <text class="name">{{item.name}}</text>
        <text wx:if="{{item.description}}" class="desc">{{item.description}}</text>
      </view>
    </block>
    <button
      wx:if="{{hasMore}}"
      class="load-more"
      loading="{{loadingMore}}"
      disabled="{{loadingMore}}"
      bindtap="loadMoreAgents"
    >
      加载更多
    </button>
  </view>
</view>
