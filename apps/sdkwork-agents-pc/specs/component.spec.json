{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-agents-pc",
    "displayName": "SDKWork Agents PC",
    "version": "0.0.0",
    "type": "pc-app-root",
    "root": "apps/sdkwork-agents-pc",
    "domain": "agents",
    "capability": "agents",
    "surface": "app",
    "languages": ["typescript"],
    "generated": false,
    "status": "active",
    "manifests": [
      "package.json",
      "sdkwork.app.config.json",
      "specs/component.spec.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "APP_PC_ARCHITECTURE_SPEC.md",
      "path": "../../../sdkwork-specs/APP_PC_ARCHITECTURE_SPEC.md",
      "purpose": "PC application root architecture."
    },
    {
      "file": "IAM_LOGIN_INTEGRATION_SPEC.md",
      "path": "../../../sdkwork-specs/IAM_LOGIN_INTEGRATION_SPEC.md",
      "purpose": "Appbase IAM login, session, and route guard integration."
    },
    {
      "file": "APP_SDK_INTEGRATION_SPEC.md",
      "path": "../../../sdkwork-specs/APP_SDK_INTEGRATION_SPEC.md",
      "purpose": "Composed SDK and global TokenManager integration."
    },
    {
      "file": "TEST_SPEC.md",
      "path": "../../../sdkwork-specs/TEST_SPEC.md",
      "purpose": "Frontend and IAM verification."
    }
  ],
  "contracts": {
    "layerRole": "frontend-shell",
    "publicExports": ["src/index.ts", "src/agents/index.ts", "src/workbench/index.ts"],
    "providedPorts": ["agents.workbench"],
    "requiredPorts": [
      "agents.home",
      "agents.assets.view",
      "agents.canvas.view",
      "agents.chat.view",
      "agents.commons",
      "agents.creative.view",
      "agents.inspiration.view",
      "agents.membership.view",
      "agents.membership.runtime",
      "agents.presentation.view",
      "agents.sdk"
    ],
    "runtimeEntrypoints": ["src/main.tsx", "package.json#scripts.dev"],
    "sdkClients": [
      "@sdkwork/agents-app-sdk",
      "@sdkwork/drive-app-sdk",
      "@sdkwork/iam-app-sdk",
      "@sdkwork/knowledgebase-app-sdk",
      "@sdkwork/memory-app-sdk",
      "@sdkwork/membership-app-sdk",
      "@sdkwork/order-app-sdk",
      "@sdkwork/prompts-app-sdk",
      "@sdkwork/skills-app-sdk",
      "@sdkwork/voice-app-sdk"
    ],
    "sdkDependencies": [
      "sdkwork-agents-app-sdk",
      "sdkwork-drive-app-sdk",
      "sdkwork-iam-app-sdk",
      "sdkwork-knowledgebase-app-sdk",
      "sdkwork-memory-app-sdk",
      "sdkwork-membership-app-sdk",
      "sdkwork-order-app-sdk",
      "sdkwork-prompts-app-sdk",
      "sdkwork-skills-app-sdk",
      "sdkwork-voice-app-sdk"
    ],
    "dependencyApiExports": [],
    "dependencyApiSurfaces": []
  },
  "verification": {
    "commands": [
      "pnpm run test:agent-contract",
      "pnpm run test:iam-contract",
      "pnpm run test:agent-contracts",
      "pnpm run build"
    ]
  }
}
