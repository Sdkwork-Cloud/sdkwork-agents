# Browser-visible Agents runtime configuration.
VITE_SDKWORK_AGENTS_PC_ENVIRONMENT="development"
VITE_SDKWORK_AGENTS_PC_APP_API_BASE_URL="http://127.0.0.1:8095/app/v3/api"
VITE_SDKWORK_AGENTS_PC_APPLICATION_PUBLIC_HTTP_URL="http://127.0.0.1:8095"

# Standalone development embeds IAM on the Agents application ingress.
VITE_SDKWORK_AGENTS_PC_APPBASE_APP_API_BASE_URL="http://127.0.0.1:8095"
# The assets API (`/app/v3/api/assets*`) is owned by the sdkwork-drive service and
# mounted same-origin on the Agents standalone gateway (port 8095). Point this at
# the Agents gateway in standalone mode; the gateway serves the embedded Drive
# app-api surface. Do not point this at other service ports (e.g. cloudrouter 3901).
VITE_SDKWORK_AGENTS_PC_DRIVE_APP_API_BASE_URL="http://127.0.0.1:8095/app/v3/api"
VITE_SDKWORK_AGENTS_PC_COMMUNITY_APP_API_BASE_URL="http://127.0.0.1:3900/app/v3/api"
VITE_SDKWORK_AGENTS_PC_GENERATIONS_APP_API_BASE_URL="http://127.0.0.1:3900/app/v3/api"
VITE_SDKWORK_AGENTS_PC_SKILLS_APP_API_BASE_URL="http://127.0.0.1:3900/app/v3/api"
VITE_SDKWORK_AGENTS_PC_DEFAULT_LOCALE="zh-CN"

# Optional capability SDKs used by the full Agent editor.
VITE_SDKWORK_AGENTS_PC_KNOWLEDGEBASE_APP_API_BASE_URL=""
VITE_SDKWORK_AGENTS_PC_VOICE_APP_API_BASE_URL=""
