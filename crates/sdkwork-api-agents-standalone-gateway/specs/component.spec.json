{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-api-agents-standalone-gateway",
    "displayName": "SDKWork Agents Standalone Gateway",
    "version": "0.1.0",
    "type": "rust-api-standalone-gateway",
    "root": "crates/sdkwork-api-agents-standalone-gateway",
    "domain": "application",
    "capability": "api-gateway",
    "surface": "gateway-api",
    "status": "ACTIVE",
    "languages": [
      "rust"
    ],
    "generated": false,
    "private": true,
    "manifests": [
      "Cargo.toml"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "APPLICATION_GATEWAY_SPEC.md",
      "path": "../../../sdkwork-specs/APPLICATION_GATEWAY_SPEC.md",
      "purpose": "Standalone application ingress and embedded platform adapter rules."
    },
    {
      "file": "IAM_LOGIN_INTEGRATION_SPEC.md",
      "path": "../../../sdkwork-specs/IAM_LOGIN_INTEGRATION_SPEC.md",
      "purpose": "Same-origin IAM login and tenant application provisioning."
    },
    {
      "file": "RUST_CODE_SPEC.md",
      "path": "../../../sdkwork-specs/RUST_CODE_SPEC.md",
      "purpose": "Rust runtime gateway structure and verification."
    }
  ],
  "contracts": {
    "layerRole": "runtime-gateway",
    "publicExports": [
      ".",
      "sdkwork_api_agents_standalone_gateway::build_router"
    ],
    "runtimeEntrypoints": [
      "src/main.rs",
      "src/bootstrap.rs#build_router",
      "Cargo.toml[[bin]].sdkwork-api-agents-standalone-gateway"
    ],
    "requiredPorts": [
      {
        "name": "agentsApiAssemblyRouter",
        "export": "sdkwork_api_agents_assembly::assemble_api_router"
      }
    ],
    "routeManifest": null,
    "sdkClients": [],
    "sdkDependencies": [
      {
        "workspace": "sdkwork-iam-app-sdk",
        "surface": "app-api",
        "credentialMode": "authenticated-app-api",
        "required": true
      }
    ],
    "dependencyApiExports": [],
    "dependencyApiSurfaces": [
      {
        "workspace": "sdkwork-iam",
        "sdkFamily": "sdkwork-iam-app-sdk",
        "apiAuthority": "sdkwork-iam-app-api",
        "surface": "app-api",
        "apiPrefix": "/app/v3/api",
        "runtimeMode": "same-origin-mounted",
        "cargoDependency": "sdkwork-api-agents-assembly",
        "embeddedExecutableExport": "sdkwork_api_agents_assembly::assemble_api_router",
        "profileCoverage": [
          "standalone"
        ],
        "coverageEvidence": [
          "../sdkwork-api-agents-assembly/src/bootstrap/iam.rs#wire_iam_app_router",
          "src/bootstrap.rs#build_router"
        ]
      }
    ],
    "events": [],
    "configKeys": [
      "SDKWORK_APP_ROOT",
      "SDKWORK_AGENTS_APP_ROOT",
      "SDKWORK_IAM_APP_ROOT",
      "SDKWORK_DATABASE_URL"
    ]
  },
  "integration": {
    "authority": "The standalone gateway owns runtime composition only; sdkwork-iam retains IAM domain, persistence, and API authority.",
    "securityPolicy": "Credential-entry routes and Agents business routes share one application ingress and token-derived request context."
  },
  "verification": {
    "commands": [
      "cargo test -p sdkwork-api-agents-assembly",
      "cargo check -p sdkwork-api-agents-standalone-gateway",
      "pnpm run api:assembly:validate"
    ]
  }
}
