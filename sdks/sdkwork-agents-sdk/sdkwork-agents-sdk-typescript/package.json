{
  "name": "@sdkwork/agents-sdk",
  "version": "0.1.0",
  "description": "SDKWork agent open API TypeScript SDK boundary.",
  "type": "module",
  "private": false,
  "sdkwork": {
    "sdkName": "sdkwork-agents-sdk",
    "authority": "sdkwork-agents-open-api",
    "apiPrefix": "/agent/v3/api",
    "sdkType": "custom",
    "sdkSurface": "open",
    "generatedOutput": "generated/server-openapi",
    "standardProfile": "sdkwork-v3",
    "sdkOwner": "sdkwork-agents",
    "sdkDependencies": []
  },
  "scripts": {
    "generate:dry-run": "node ../../workspace-agent-sdkgen.mjs --family open --mode dry-run",
    "generate": "node ../../workspace-agent-sdkgen.mjs --family open --mode apply",
    "verify": "node ../bin/verify-sdk.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@sdkwork/sdk-common": "workspace:*"
  }
}
