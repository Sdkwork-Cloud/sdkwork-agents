{
  "name": "@sdkwork/agents-backend-sdk",
  "version": "0.1.0",
  "description": "SDKWork agent backend API TypeScript SDK boundary.",
  "type": "module",
  "private": false,
  "sdkwork": {
    "sdkName": "sdkwork-agents-backend-sdk",
    "authority": "sdkwork-agents-backend-api",
    "apiPrefix": "/backend/v3/api",
    "sdkType": "backend",
    "sdkSurface": "backend",
    "generatedOutput": "generated/server-openapi",
    "standardProfile": "sdkwork-v3",
    "sdkOwner": "sdkwork-agents",
    "sdkDependencies": [
      {
        "workspace": "sdkwork-iam-backend-sdk",
        "role": "appbase-backend-management-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/backend/v3/api",
        "apiAuthority": "sdkwork-iam-backend-api",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/iam-backend-sdk"
        }
      }
    ]
  },
  "scripts": {
    "generate:dry-run": "node ../../workspace-agent-sdkgen.mjs --family backend --mode dry-run",
    "generate": "node ../../workspace-agent-sdkgen.mjs --family backend --mode apply",
    "verify": "node ../bin/verify-sdk.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@sdkwork/sdk-common": "workspace:*"
  }
}
