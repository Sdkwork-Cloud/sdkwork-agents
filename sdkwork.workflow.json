{
  "$schema": "../sdkwork-github-workflow/schemas/sdkwork-workflow.schema.json",
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-agents",
    "name": "SDKWork Agents",
    "repository": "Sdkwork-Cloud/sdkwork-agents",
    "sourcePath": ".",
    "configPath": "sdkwork.app.config.json"
  },
  "release": {
    "artifactPrefix": "sdkwork-agents",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "app-manifest",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-kernel",
      "repository": "Sdkwork-Cloud/sdkwork-kernel",
      "refInput": "SDKWORK_KERNEL_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "Sdkwork-Cloud/sdkwork-web-framework",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-iam",
      "repository": "Sdkwork-Cloud/sdkwork-iam",
      "refInput": "SDKWORK_IAM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-id",
      "repository": "Sdkwork-Cloud/sdkwork-id",
      "refInput": "SDKWORK_ID_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "Sdkwork-Cloud/sdkwork-database",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-utils",
      "repository": "Sdkwork-Cloud/sdkwork-utils",
      "refInput": "SDKWORK_UTILS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-prompts",
      "repository": "Sdkwork-Cloud/sdkwork-prompts",
      "refInput": "SDKWORK_PROMPTS_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sandbox",
      "repository": "Sdkwork-Cloud/sdkwork-sandbox",
      "refInput": "SDKWORK_SANDBOX_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "Sdkwork-Cloud/sdkwork-drive",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-knowledgebase",
      "repository": "Sdkwork-Cloud/sdkwork-knowledgebase",
      "refInput": "SDKWORK_KNOWLEDGEBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-app-topology",
      "repository": "Sdkwork-Cloud/sdkwork-app-topology",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.30.2",
    "rust": "stable"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install workspace dependencies",
        "shell": "pwsh",
        "run": "pnpm install --frozen-lockfile"
      }
    ],
    "preflight": [
      {
        "name": "Validate application lifecycle contracts",
        "shell": "pwsh",
        "run": "pnpm exec sdkwork-app doctor"
      }
    ],
    "build": [
      {
        "name": "Verify agents architecture alignment",
        "shell": "pwsh",
        "run": "node tools/check_sdkwork_agents_architecture_alignment.mjs"
      },
      {
        "name": "Build Rust workspace",
        "shell": "pwsh",
        "run": "cargo build --workspace --release"
      }
    ],
    "package": [
      {
        "name": "Build Agents gateway and task worker artifacts",
        "shell": "pwsh",
        "run": "cargo build --locked --release -p sdkwork-api-agents-standalone-gateway -p sdkwork-intelligence-agents-worker"
      }
    ],
    "sign": [
      {
        "name": "Sign Agents artifact",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\nnode scripts/release/workflow-supply-chain-evidence.mjs sign"
      }
    ],
    "sbom": [
      {
        "name": "Generate Agents SBOM and provenance",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\nnode scripts/release/workflow-supply-chain-evidence.mjs attest"
      }
    ],
    "validate": [
      {
        "name": "Validate Agents workspace (pnpm verify)",
        "shell": "pwsh",
        "run": "pnpm verify"
      }
    ]
  },
  "targets": [
    {
      "id": "linux-x64-standalone-server-tar-gz",
      "profileBinding": "fixed",
      "deploymentProfile": "standalone",
      "runtimeTarget": "server",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": ["tar.gz"],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release-packages/sdkwork-agents-linux-x64-standalone-server-tar-gz-0.1.0.tar.gz",
        "dist/release-evidence/linux-x64-standalone-server-tar-gz/*"
      ],
      "artifactPath": "dist/release-packages/sdkwork-agents-linux-x64-standalone-server-tar-gz-0.1.0.tar.gz"
    },
    {
      "id": "container-x64-cloud-container-kubernetes-tar-gz",
      "profileBinding": "fixed",
      "deploymentProfile": "cloud",
      "runtimeTarget": "container",
      "profile": "container",
      "platform": "container",
      "architecture": "x64",
      "variant": "kubernetes",
      "formats": ["tar.gz"],
      "runner": "ubuntu-24.04",
      "outputGlobs": [
        "dist/release-packages/sdkwork-agents-container-x64-cloud-container-kubernetes-tar-gz-0.1.0.tar.gz",
        "dist/release-evidence/container-x64-cloud-container-kubernetes-tar-gz/*"
      ],
      "artifactPath": "dist/release-packages/sdkwork-agents-container-x64-cloud-container-kubernetes-tar-gz-0.1.0.tar.gz"
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": true
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": false,
    "retentionDays": 30
  }
}
