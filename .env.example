# SDKWork Agents local development environment
# Copy to .env and adjust values for your workstation.

SDKWORK_AGENTS_ENVIRONMENT=development
SDKWORK_AGENTS_CONFIG_PROFILE=dev
SDKWORK_AGENTS_DEV_AUTH_BYPASS=true
SDKWORK_AGENTS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8095
SDKWORK_AGENTS_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8095

# Canonical IAM identity defaults for local bootstrap
SDKWORK_TENANT_ID=100001
SDKWORK_ORGANIZATION_ID=0
SDKWORK_APP_ID=sdkwork-agents

# Canonical Agents domain database (ai_* tables) — unified sdkwork_ai_dev
SDKWORK_DATABASE_URL=postgres://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev

# Kernel runtime session persistence (sdkwork-agent-database)
SDKWORK_DATABASE_PATH=.runtime/agent-server.sqlite
SDKWORK_DATABASE_URL=postgres://sdkwork_ai_dev:sdkworkdev123@127.0.0.1:5432/sdkwork_ai_dev
