{
  "name": "sdkwork-agents-workspace",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "dependencies": {
    "@sdkwork/app-topology": "workspace:*",
    "yaml": "^2.8.0"
  },
  "scripts": {
    "stop": "node ../sdkwork-specs/tools/stop-sdkwork-workspace-processes.mjs --workspace .",    "dev": "node scripts/agents-dev.mjs",
    "build": "cargo build --workspace --release",
    "test": "node scripts/cargo-test-workspace.mjs && node --test tests/contract/platform-integration.contract.test.mjs tests/contract/database-framework.contract.test.mjs tests/contract/root-quality-gates.contract.test.mjs tests/contract/production-security.contract.test.mjs tests/contract/frontend-service-identity.contract.test.mjs tests/contract/rust-service-module-boundaries.contract.test.mjs tests/contract/component-spec-inventory.contract.test.mjs tests/contract/dev-runtime-access.contract.test.mjs && node scripts/agents-open-sdk-surface-contract.test.mjs && node scripts/mini-program-runtime-contract.test.mjs && node scripts/client-surface-readiness-contract.test.mjs",
    "check": "pnpm run check:app-composition && pnpm check:component-port-bindings && pnpm check:frontend-composition && pnpm check:frontend-service-identity && pnpm check:pc-upload-boundary && pnpm check:permission-composition && pnpm check:composition-resolver && pnpm check:rust-backend-composition && pnpm check:architecture-alignment && pnpm check:identity-alignment && pnpm check:api-envelope && pnpm check:api-operation-patterns && pnpm check:route-path-collisions && pnpm check:pagination && pnpm check:app-sdk-consumer-imports && pnpm check:agent-sdk-workspace && pnpm check:apps-directory-index && pnpm check:production-security && pnpm check:deploy && pnpm gateway:validate:cloud && pnpm check:docs && pnpm check:pnpm-script-standard && pnpm check:agent-workflow-standard && pnpm topology:validate && pnpm db:validate",
    "check:api-envelope": "node ../sdkwork-specs/tools/check-api-response-envelope.mjs --workspace .",
    "check:api-operation-patterns": "node ../sdkwork-specs/tools/check-api-operation-patterns.mjs --workspace .",
    "check:pagination": "node ../sdkwork-specs/tools/check-pagination.mjs --workspace .",
    "check:app-sdk-consumer-imports": "node ../sdkwork-specs/tools/check-app-sdk-consumer-imports.mjs --workspace .",
    "check:agent-sdk-workspace": "node scripts/check-agent-sdk-workspace.mjs",
    "check:route-path-collisions": "node ../sdkwork-specs/tools/check-route-path-collisions.mjs --workspace .",
    "check:apps-directory-index": "node ../sdkwork-specs/tools/check-apps-directory-index.mjs --root .",
    "check:production-security": "node --test tests/contract/production-security.contract.test.mjs",
    "check:frontend-service-identity": "node --test tests/contract/frontend-service-identity.contract.test.mjs",
    "check:pc-upload-boundary": "node --test tests/contract/pc-upload-boundary.contract.test.mjs",
    "check:component-port-bindings": "node ../sdkwork-specs/tools/check-component-port-bindings.mjs --root .",
    "check:frontend-composition": "node ../sdkwork-specs/tools/check-frontend-composition.mjs --root .",
    "check:permission-composition": "node ../sdkwork-specs/tools/check-permission-composition.mjs --root .",
    "check:composition-resolver": "node ../sdkwork-specs/tools/check-composition-resolver.mjs --root .",
    "check:rust-backend-composition": "node ../sdkwork-specs/tools/check-rust-backend-composition.mjs --root .",
    "check:deploy": "node ../sdkwork-specs/tools/check-deploy-standard.mjs --root .",
    "check:docs": "node ../sdkwork-specs/tools/check-repository-docs-standard.mjs --root .",
    "check:architecture-alignment": "node tools/check_sdkwork_agents_architecture_alignment.mjs",
    "check:identity-alignment": "node tools/check_agents_identity_alignment.mjs",
    "check:pnpm-script-standard": "node ../sdkwork-specs/tools/check-pnpm-script-standard.mjs --root . --product-prefix agents,agent",
    "check:agent-workflow-standard": "node ../sdkwork-specs/tools/check-agent-workflow-standard.mjs --root .",
    "check:contracts": "node --test tests/contract/platform-integration.contract.test.mjs tests/contract/database-framework.contract.test.mjs tests/contract/root-quality-gates.contract.test.mjs tests/contract/production-security.contract.test.mjs tests/contract/frontend-service-identity.contract.test.mjs tests/contract/pc-upload-boundary.contract.test.mjs tests/contract/rust-service-module-boundaries.contract.test.mjs tests/contract/component-spec-inventory.contract.test.mjs tests/contract/dev-runtime-access.contract.test.mjs && node scripts/agents-open-sdk-surface-contract.test.mjs && node scripts/mini-program-runtime-contract.test.mjs && node scripts/client-surface-readiness-contract.test.mjs",
    "verify": "pnpm check && pnpm workflow:build-agents-app-sdk && cargo build --workspace && node scripts/cargo-test-workspace.mjs && pnpm --filter @sdkwork/agents-mini-program build && pnpm check:contracts && pnpm workflow:typecheck-client-surfaces && pnpm --filter @sdkwork/agents-pc test:agent-contracts",
    "clean": "cargo clean",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_agents_baseline.sql --module-id agents --owner agents-platform --prefixes ai_ --engines postgres",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "gateway:assembly:materialize": "node scripts/gateway/assembly-materialize.mjs",
    "gateway:assembly:validate": "node scripts/gateway/assembly-validate.mjs",
    "gateway:package:cloud": "node scripts/package-cloud-gateway-config.mjs",
    "workflow:materialize-client-surfaces": "node scripts/materialize-client-app-surfaces.mjs",
    "workflow:sync-agent-h5-from-pc": "node scripts/materialize-h5-agents-from-pc.mjs && node scripts/sync-h5-core-from-pc.mjs",
    "workflow:build-agents-app-sdk": "pnpm --filter @sdkwork/agents-app-sdk build",
    "workflow:align-client-composition": "node scripts/align-client-dependency-composition.mjs",
    "start:desktop": "pnpm --filter @sdkwork/agents-pc dev",
    "start:browser": "pnpm --filter @sdkwork/agents-h5 dev",
    "start:mini-program": "pnpm --filter @sdkwork/agents-mini-program dev",
    "smoke:live": "node scripts/agents-live-smoke.mjs",
    "workflow:build-client-surfaces": "pnpm --filter @sdkwork/agents-pc build && pnpm --filter @sdkwork/agents-h5 build && pnpm --filter @sdkwork/agents-mini-program build",
    "workflow:typecheck-client-surfaces": "pnpm --filter @sdkwork/agents-pc typecheck && pnpm --filter @sdkwork/agents-h5 typecheck && pnpm --filter @sdkwork/agents-mini-program typecheck",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "gateway:validate:cloud": "node ../sdkwork-app-topology/scripts/gateway-cloud-bundle.mjs validate --root ."
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
